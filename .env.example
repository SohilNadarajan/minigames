# Copy to `.env` in the project root (same folder as package.json).
# Vite only loads variables prefixed with VITE_.
#
# Security: if this repo is ever public or shared, do not commit real keys in
# `.env.example`—use placeholders here and keep secrets only in `.env`.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional
